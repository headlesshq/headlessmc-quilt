{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [':enableRenovate', ':semanticCommits', 'config:best-practices'],
  timezone: 'UTC',
  dependencyDashboard: true,
  platformCommit: 'enabled',
  prCreation: 'not-pending',
  rebaseWhen: 'conflicted',
  suppressNotifications: ['prIgnoreNotification'],
  enabledManagers: ['gradle', 'gradle-wrapper', 'github-actions', 'git-submodules', 'devcontainer'],
  // git-submodules is disabled by default. Renovate follows the `branch` set in .gitmodules.
  'git-submodules': { enabled: true },
  packageRules: [
    { matchUpdateTypes: ['major'], addLabels: ['dependency/major'] },
    { matchUpdateTypes: ['minor'], addLabels: ['dependency/minor'] },
    { matchUpdateTypes: ['patch'], addLabels: ['dependency/patch'] },
    {
      matchManagers: ['gradle'],
      semanticCommitType: 'fix',
      semanticCommitScope: 'deps',
    },
    {
      matchManagers: ['gradle-wrapper'],
      semanticCommitType: 'build',
      semanticCommitScope: 'deps',
    },
    {
      matchManagers: ['github-actions'],
      semanticCommitType: 'ci',
      semanticCommitScope: 'deps',
    },
    {
      // The headlessmc-gradle-plugin submodule is temporary until the plugin is released.
      // Use `build(deps)` so that not every commit of it causes a plugin release.
      matchManagers: ['git-submodules'],
      semanticCommitType: 'build',
      semanticCommitScope: 'deps',
    },
    {
      matchManagers: ['devcontainer'],
      semanticCommitType: 'build',
      semanticCommitScope: 'deps',
    },
  ],
}
